---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import { t, localePath } from '../../lib/i18n.js';

const { locale = 'en' } = Astro.props;
const slugOf = (entry) => entry.id.replace(new RegExp(`^${locale}/`), "");

const all = await getCollection('law', (e) => e.id.startsWith(`${locale}/`));

const byOrder = (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99);
const ofKind = (kind) => all.filter((e) => e.data.kind === kind).sort(byOrder);

const withContent = async (entries) =>
  Promise.all(
    entries.map(async (entry) => ({
      slug: slugOf(entry),
      data: entry.data,
      Content: (await render(entry)).Content,
    })),
  );

const settings = await withContent(ofKind('setting'));
const findings = await withContent(ofKind('finding'));
const states = await withContent(ofKind('state'));
const openQuestions = await withContent(ofKind('open-question'));

const lastUpdated = all
  .map((entry) => entry.data.lastUpdated)
  .sort()
  .at(-1);

/** The table cell, spelled out in words so it survives greyscale and screen readers. */
const FERPA_LABEL = {
  yes: 'Yes',
  no: 'No',
  'not-directly': 'Not directly',
  depends: 'Depends',
};

const description =
  'Which law actually governs the data in your early childhood program, setting by setting: FERPA, Head Start Part 1303, IDEA, COPPA and the state layer. An unreviewed working draft that has not been through counsel.';
---

<BaseLayout title="What the law says" description={description} locale={locale} fullWidth>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <PageHeader
        caption="What the law says"
        title="Which law actually governs the data in my program?"
        lede="The answer changes completely depending on who operates the program. A district-run pre-K classroom, a Head Start grantee that is a community action agency and a family child care home are under three different sets of rules — and most of the vendor contract templates in circulation cite the wrong statute for all but the first."
        locale={locale}
        lastUpdated={lastUpdated}
      />

      <div
        class="govuk-notification-banner"
        role="region"
        aria-labelledby="counsel-banner-title"
        data-module="govuk-notification-banner"
      >
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="counsel-banner-title">
            No lawyer has read this page
          </h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">
            This crosswalk is an unreviewed working draft. It is not legal advice, and it cannot
            ship as a field standard until an attorney owns it.
          </p>
          <p class="govuk-body">
            Two readings in particular are unresolved and are marked as such below: whether
            <a class="govuk-notification-banner__link" href="#question-ny-ed-law-2d">
              New York Education Law 2-d reaches community-based pre-K providers
            </a>, and
            <a class="govuk-notification-banner__link" href="#question-illinois-soppa">
              whether Illinois SOPPA reaches preschool at all
            </a>. The state lookup further down is deliberately full of empty answers. An honest
            blank is the point: nothing has been filled in that could not be traced to a source.
          </p>
        </div>
      </div>

      <h2 class="govuk-heading-m" id="contents">{t(locale, 'label.onThisPage')}</h2>
      <ul class="govuk-list govuk-list--bullet">
        <li><a class="govuk-link" href="#crosswalk">The crosswalk: six settings, six answers</a></li>
        <li><a class="govuk-link" href="#settings">Each setting in full</a></li>
        <li><a class="govuk-link" href="#findings">Three findings that change practice</a></li>
        <li><a class="govuk-link" href="#states">The state layer</a></li>
        <li><a class="govuk-link" href="#open-questions">Open questions for a lawyer</a></li>
      </ul>

      <h2 class="govuk-heading-l govuk-!-margin-top-8" id="crosswalk">
        The crosswalk: six settings, six answers
      </h2>
      <p class="govuk-body">
        Find the row that describes who operates your program. FERPA — the Family Educational
        Rights and Privacy Act — applies in two of these six settings. In the other four, a policy
        or a vendor agreement that opens by reciting FERPA is describing a statute that does not
        govern you.
      </p>
    </div>
  </div>

  <div
    class="app-table-scroll govuk-!-margin-bottom-8"
    tabindex="0"
    role="region"
    aria-labelledby="crosswalk-table-caption"
  >
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-table__caption--m" id="crosswalk-table-caption">
        Which law governs, by who operates the program
      </caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Setting</th>
          <th scope="col" class="govuk-table__header">Does FERPA apply?</th>
          <th scope="col" class="govuk-table__header">What governs instead</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {settings.map((setting) => (
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              <a class="govuk-link govuk-link--no-visited-state" href={`#setting-${setting.slug}`}>
                {setting.data.title}
              </a>
            </th>
            <td class="govuk-table__cell">{FERPA_LABEL[setting.data.ferpa] ?? '—'}</td>
            <td class="govuk-table__cell">
              <ul class="govuk-list govuk-list--bullet govuk-body-s govuk-!-margin-bottom-0">
                {setting.data.governsInstead.map((item) => <li>{item}</li>)}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <h2 class="govuk-heading-l govuk-!-margin-top-4" id="settings">Each setting in full</h2>

      {settings.map((setting) => (
        <section id={`setting-${setting.slug}`} class="govuk-!-margin-bottom-8">
          <h3 class="govuk-heading-m govuk-!-margin-bottom-2">
            <span class="govuk-caption-m">
              FERPA: {FERPA_LABEL[setting.data.ferpa] ?? 'Not stated'}
            </span>
            {setting.data.title}
          </h3>

          <div class="app-prose govuk-!-margin-bottom-4">
            <setting.Content />
          </div>

          {setting.data.authorities.length > 0 && (
            <>
              <h4 class="govuk-heading-s govuk-!-margin-bottom-1">{t(locale, 'label.authority')}</h4>
              <ul class="govuk-list govuk-list--bullet govuk-body-s">
                {setting.data.authorities.map((authority) => <li>{authority}</li>)}
              </ul>
            </>
          )}
        </section>
      ))}

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

      <h2 class="govuk-heading-l govuk-!-margin-top-6" id="findings">
        Three findings that change practice
      </h2>
      <p class="govuk-body">
        The table settles which statute you are under. These three are the reason the page exists:
        each one is a place where the practice the field has settled into does not match what the
        law actually says.
      </p>

      {findings.map((finding, i) => (
        <section id={`finding-${finding.slug}`} class="govuk-!-margin-bottom-8">
          <h3 class="govuk-heading-m govuk-!-margin-bottom-2">
            <span class="govuk-caption-m">Finding {i + 1} of {findings.length}</span>
            {finding.data.title}
          </h3>

          {finding.data.needsLegalReview && (
            <div class="govuk-warning-text">
              <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
              <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                This finding names an unsettled question rather than resolving it. It needs a
                lawyer before anyone relies on it.
              </strong>
            </div>
          )}

          <div class="app-prose govuk-!-margin-bottom-4">
            <finding.Content />
          </div>

          {finding.data.authorities.length > 0 && (
            <>
              <h4 class="govuk-heading-s govuk-!-margin-bottom-1">{t(locale, 'label.authority')}</h4>
              <ul class="govuk-list govuk-list--bullet govuk-body-s">
                {finding.data.authorities.map((authority) => <li>{authority}</li>)}
              </ul>
            </>
          )}
        </section>
      ))}

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

      <h2 class="govuk-heading-l govuk-!-margin-top-6" id="states">The state layer</h2>
      <p class="govuk-body">
        State law is where this moves fastest, so the state layer is built as a lookup rather than
        as prose, and it is honest about what it does not know. These six states are here because
        of where dual language learners and providers are concentrated: California, Texas, New
        York, Florida, New Jersey and Illinois.
      </p>
      <p class="govuk-body">
        Every state answers the same four questions. Where this draft cannot trace an answer to a
        source, the answer reads <strong>Not established here</strong> rather than a guess. Every
        entry below is marked as awaiting legal review.
      </p>

      <ol class="govuk-list govuk-list--number govuk-!-margin-bottom-6">
        <li>Does the state&rsquo;s student-privacy law reach pre-K or child care?</li>
        <li>Is there a biometric statute with a private right of action?</li>
        <li>What do the state&rsquo;s CCDF plan and provider agreement require? CCDF is the Child Care and Development Fund, the federal money that flows through the state to subsidised programs.</li>
        <li>What has the state AI office or education department published that a provider might be handed?</li>
      </ol>

      <div class="govuk-accordion" data-module="govuk-accordion" id="state-lookup">
        {states.map((state, i) => (
          <div class="govuk-accordion__section">
            <div class="govuk-accordion__section-header">
              <h3 class="govuk-accordion__section-heading">
                <span class="govuk-accordion__section-button" id={`state-heading-${i + 1}`}>
                  {state.data.title}
                </span>
              </h3>
              <div class="govuk-accordion__section-summary govuk-body" id={`state-summary-${i + 1}`}>
                {state.data.stateCode} &middot; Awaiting legal review
              </div>
            </div>
            <div id={`state-content-${i + 1}`} class="govuk-accordion__section-content">
              <div class="app-prose">
                <state.Content />
              </div>

              {state.data.authorities.length > 0 && (
                <>
                  <h4 class="govuk-heading-s govuk-!-margin-top-4 govuk-!-margin-bottom-1">
                    {t(locale, 'label.authority')}
                  </h4>
                  <ul class="govuk-list govuk-list--bullet govuk-body-s">
                    {state.data.authorities.map((authority) => <li>{authority}</li>)}
                  </ul>
                </>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="govuk-body govuk-!-margin-top-6">
        If your state is not one of the six, the federal answer for your setting in the crosswalk
        above is your floor, and the
        <a class="govuk-link" href={localePath(locale, '/vendors')}>questions to ask a vendor</a>
        are the practical way to get in writing what a state statute may or may not already
        require.
      </p>

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

      <h2 class="govuk-heading-l govuk-!-margin-top-6" id="open-questions">
        Open questions for a lawyer
      </h2>
      <p class="govuk-body">
        Two state readings need an attorney before this page can be published as anything other
        than a draft. They are set out here rather than resolved, because both are consequential
        in either direction and neither could be confirmed for this draft. Both should be owned by
        a pro bono legal partner, which this site does not yet have.
      </p>

      {openQuestions.map((question) => (
        <section
          id={`question-${question.slug.replace(/^open-question-/, '')}`}
          class="govuk-!-margin-bottom-8"
        >
          <h3 class="govuk-heading-m govuk-!-margin-bottom-2">
            <span class="govuk-caption-m">Open question</span>
            {question.data.title}
          </h3>

          <div class="govuk-inset-text">
            <p class="govuk-body-s govuk-!-margin-bottom-0">
              Unresolved. Nothing on this page asks you to act on either reading.
            </p>
          </div>

          <div class="app-prose govuk-!-margin-bottom-4">
            <question.Content />
          </div>

          {question.data.authorities.length > 0 && (
            <>
              <h4 class="govuk-heading-s govuk-!-margin-bottom-1">{t(locale, 'label.authority')}</h4>
              <ul class="govuk-list govuk-list--bullet govuk-body-s">
                {question.data.authorities.map((authority) => <li>{authority}</li>)}
              </ul>
            </>
          )}
        </section>
      ))}

      <div class="govuk-inset-text">
        <p class="govuk-body">
          <strong>What this page is for.</strong> It tells you which statute to argue from. It does
          not tell you what your particular contract says, and it has not been reviewed by counsel.
          Where the crosswalk leaves you with contract leverage rather than statutory protection —
          which is four of the six settings — the
          <a class="govuk-link" href={localePath(locale, '/vendors')}>ten questions to ask a vendor</a>
          and the
          <a class="govuk-link" href={localePath(locale, '/policies')}>documents on the shelf</a>
          are where that leverage is written down.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
