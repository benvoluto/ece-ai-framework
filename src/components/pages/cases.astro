---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import Annotation from '../Annotation.astro';
import PrincipleRefs from '../PrincipleRefs.astro';
import TierTag from '../TierTag.astro';
import { t, localePath } from '../../lib/i18n.js';

const { locale = 'en' } = Astro.props;

const all = await getCollection('cases', (entry) => entry.id.startsWith(`${locale}/`));
const sorted = [...all].sort((a, b) => a.data.order - b.data.order);
const slugOf = (entry) => entry.id.split('/').slice(1).join('/');

const drafted = await Promise.all(
  sorted
    .filter((entry) => entry.data.status === 'drafted')
    .map(async (entry) => ({ entry, slug: slugOf(entry), Content: (await render(entry)).Content }))
);
const toDraft = sorted
  .filter((entry) => entry.data.status === 'to-draft')
  .map((entry) => ({ entry, slug: slugOf(entry) }));

const copy = {
  en: {
    pageTitle: 'Cases',
    caption: 'Worked examples',
    lede: 'Nine situations a director actually meets, each one worked through to a decision she can make this week.',
    description:
      'Short worked vignettes: the situation, what is at stake, what to do, and which principle governs.',
    introGovernance:
      'Almost every comparable framework is governance: who approves, what gets disclosed, how data is stored. Very little of it addresses the actual moment of use — the feature that switched itself on, the teacher at 6pm with an incident to write up, the family waiting for a screening result in a language nobody in the building speaks.',
    introMoments:
      'These are those moments. Every case has the same four parts: the situation, what is at stake, what to do, and which principle governs. They are written to be forwarded, so take any one of them on its own.',
    comingHeading: 'Three more cases, coming',
    comingIntro:
      'These three are named and are not written. Each one is here rather than quietly missing, because a director who meets one of these situations should know the site has not yet answered it.',
    growth:
      'The library is meant to launch at eight or nine vignettes and then grow by roughly one a month. That growth is second-phase work: it depends on a convened body to stand behind the additions, and on the pilots and questions that body would bring with it. Until then the honest position is the one on this page — six worked through, three named and waiting.',
    elsewhereLead:
      'If your situation is not here, the four pages behind these cases will usually get you to an answer:',
    linkBrightLines: 'the bright lines',
    linkPrinciples: 'the principles',
    linkVendors: 'the vendor questions',
    elsewhereAnd: 'and',
    linkIntake: 'the four-question intake',
    elsewhereTail: ', which returns a tier.',
    settings: {
      fcc: 'Family child care',
      center: 'Center',
      'multi-site': 'Multi-site operator',
      intermediary: 'Intermediary',
    },
  },
  es: {
    pageTitle: 'Casos',
    caption: 'Ejemplos resueltos',
    lede: 'Nueve situaciones que una directora de verdad se encuentra, cada una trabajada hasta llegar a una decisión que puede tomar esta semana.',
    description:
      'Viñetas breves y resueltas: la situación, qué está en juego, qué hacer y qué principio rige.',
    introGovernance:
      'Casi todos los marcos parecidos tratan de gobernanza: quién aprueba, qué se informa, cómo se guardan los datos. Muy poco de eso habla del momento real del uso — la función que se encendió sola, la maestra a las 6 de la tarde con un incidente que redactar, la familia esperando el resultado de una evaluación en un idioma que nadie en el edificio habla.',
    introMoments:
      'Estos son esos momentos. Cada caso tiene las mismas cuatro partes: la situación, qué está en juego, qué hacer y qué principio rige. Están escritos para reenviarse, así que puede tomar cualquiera de ellos por separado.',
    comingHeading: 'Tres casos más, en camino',
    comingIntro:
      'Estos tres están nombrados y no están escritos. Cada uno aparece aquí en lugar de faltar en silencio, porque una directora que se encuentre con una de estas situaciones debe saber que el sitio todavía no la ha respondido.',
    growth:
      'La biblioteca está pensada para salir con ocho o nueve viñetas y después crecer más o menos una por mes. Ese crecimiento es trabajo de la segunda fase: depende de que se convoque un organismo que respalde lo que se agregue, y de los pilotos y las preguntas que ese organismo traería consigo. Mientras tanto, la posición honesta es la de esta página — seis trabajados a fondo, tres nombrados y esperando.',
    elsewhereLead:
      'Si su situación no está aquí, las cuatro páginas detrás de estos casos casi siempre lo llevan a una respuesta:',
    linkBrightLines: 'los límites infranqueables',
    linkPrinciples: 'los principios',
    linkVendors: 'las preguntas para proveedores',
    elsewhereAnd: 'y',
    linkIntake: 'la herramienta de cuatro preguntas',
    elsewhereTail: ', que devuelve un nivel.',
    settings: {
      fcc: 'Cuidado infantil familiar',
      center: 'Centro',
      'multi-site': 'Operador con varias sedes',
      intermediary: 'Intermediario',
    },
  },
};

const c = copy[locale] ?? copy.en;

const SETTINGS = c.settings;

const lastUpdated = sorted
  .map((entry) => entry.data.lastUpdated)
  .sort()
  .at(-1);

const description = c.description;
---

<BaseLayout title={c.pageTitle} description={description} locale={locale}>
  <PageHeader
    caption={c.caption}
    title={c.pageTitle}
    lede={c.lede}
    locale={locale}
    lastUpdated={lastUpdated}
  />

  <p class="govuk-body">
    {c.introGovernance}
  </p>

  <p class="govuk-body">
    {c.introMoments}
  </p>

  <nav class="govuk-!-margin-bottom-8" aria-labelledby="contents">
    <h2 class="govuk-heading-s" id="contents">{t(locale, 'label.onThisPage')}</h2>
    <ol class="govuk-list govuk-list--number">
      {drafted.map(({ entry, slug }) => (
        <li>
          <a class="govuk-link" href={`#${slug}`}>{entry.data.title}</a>
        </li>
      ))}
      <li><a class="govuk-link" href="#coming">{c.comingHeading}</a></li>
    </ol>
  </nav>

  {drafted.map(({ entry, slug, Content }) => (
    <section id={slug} class="govuk-!-margin-bottom-8">
      <h2 class="govuk-heading-m govuk-!-margin-bottom-2">{entry.data.title}</h2>

      <p class="govuk-body-s govuk-!-margin-bottom-4">
        {entry.data.tier !== undefined && (
          <span class="govuk-!-margin-right-3">
            <TierTag tier={entry.data.tier} locale={locale} />
          </span>
        )}
        {entry.data.settings.length > 0 && (
          <span>
            {t(locale, 'label.for')}:{' '}
            {entry.data.settings.map((s) => SETTINGS[s] ?? s).join(' · ')}
          </span>
        )}
      </p>

      <p class="govuk-body-l"><strong>{entry.data.situation}</strong></p>

      <Annotation label={t(locale, 'label.atStake')}>
        <p class="govuk-body govuk-!-margin-bottom-0">{entry.data.atStake}</p>
      </Annotation>

      <Annotation label={t(locale, 'label.do')}>
        <p class="govuk-body govuk-!-margin-bottom-0">{entry.data.whatToDo}</p>
      </Annotation>

      <div class="app-prose govuk-!-margin-bottom-4">
        <Content />
      </div>

      <PrincipleRefs
        ids={entry.data.governs}
        brightLines={entry.data.brightLines}
        locale={locale}
      />

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />
    </section>
  ))}

  <section id="coming">
    <h2 class="govuk-heading-m">{c.comingHeading}</h2>

    <p class="govuk-body">
      {c.comingIntro}
    </p>

    <div class="govuk-inset-text">
      <dl class="govuk-!-margin-bottom-0">
        {toDraft.map(({ entry }) => (
          <>
            <dt class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">
              {entry.data.title}
            </dt>
            <dd class="govuk-body govuk-!-margin-left-0 govuk-!-margin-bottom-4">
              {entry.data.situation}
            </dd>
          </>
        ))}
      </dl>
    </div>

    <p class="govuk-body">
      {c.growth}
    </p>

    <p class="govuk-body">
      {c.elsewhereLead}{' '}
      <a class="govuk-link" href={localePath(locale, '/bright-lines')}>{c.linkBrightLines}</a>,{' '}
      <a class="govuk-link" href={localePath(locale, '/principles')}>{c.linkPrinciples}</a>,{' '}
      <a class="govuk-link" href={localePath(locale, '/vendors')}>{c.linkVendors}</a>{' '}
      {c.elsewhereAnd} <a class="govuk-link" href={localePath(locale, '/start')}>{c.linkIntake}</a>{c.elsewhereTail}
    </p>
  </section>
</BaseLayout>
