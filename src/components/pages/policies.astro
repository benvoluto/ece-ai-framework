---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import TierTag from '../TierTag.astro';
import { localePath } from '../../lib/i18n.js';

const { locale = 'en' } = Astro.props;

const all = (await getCollection('artifacts'))
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const slugOf = (entry) => entry.id.replace(new RegExp(`^${locale}/`), "");

/** Group by who the document is for, in the order a reader arrives in. */
const GROUPS = [
  {
    id: 'single-site',
    title: 'Family child care and single sites',
    blurb:
      'If only one artifact gets built well, it is the one-page policy. Print it, read it, sign it, date it.',
    match: (d) => d.forWhom?.includes('fcc') && !d.forWhom?.includes('multi-site'),
  },
  {
    id: 'centers',
    title: 'Centers',
    blurb:
      'Longer, and structured so a director can delete the sections that do not apply.',
    match: (d) => d.forWhom?.includes('center') && !d.forWhom?.includes('fcc'),
  },
  {
    id: 'multi-site',
    title: 'Multi-site operators, chains and Head Start grantees',
    blurb:
      'A governance structure and model contract language, not a longer policy. These exist because they do not make sense below a certain size.',
    match: (d) => d.forWhom?.includes('multi-site') && !d.forWhom?.includes('fcc') && !d.forWhom?.includes('center'),
  },
  {
    id: 'intermediaries',
    title: 'Intermediaries',
    blurb: 'For a CDFI, a resource and referral agency, or a training and technical assistance provider.',
    match: (d) => d.forWhom?.includes('intermediary') && !d.forWhom?.includes('fcc'),
  },
];

const grouped = GROUPS.map((group) => ({
  ...group,
  entries: all.filter((entry) => group.match(entry.data)),
}));

const placed = new Set(grouped.flatMap((g) => g.entries.map((e) => e.id)));
const everyone = all.filter((entry) => !placed.has(entry.id));

const shelf = all
  .filter((entry) => entry.data.onShelf)
  .sort((a, b) => (a.data.shelfOrder ?? 99) - (b.data.shelfOrder ?? 99));
---

<BaseLayout
  title="Policies to adopt"
  description="Sixteen artifacts in editable formats, with fill-in markers, last-updated stamps, and a Spanish version of each. No form, no email capture."
  locale={locale}
  fullWidth
>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <PageHeader
        caption="Policies to adopt"
        title="Sixteen artifacts, not one policy"
        lede="Every one ships editable, with fill-in markers where your own text goes, a last-updated stamp, and a Spanish version. No form, no email capture — anything that gates a policy template behind a signup loses the providers who need it most."
        locale={locale}
      />

      <p class="govuk-body">
        Each document is a page you can read, a Word file you can edit, and a Markdown file you can
        do anything with. All three come from one source, so they cannot drift apart.
      </p>
      <p class="govuk-body">
        Two variants of the core policy are published rather than one canonical version. That is
        deliberate: it lowers the stakes of choosing.
      </p>
      <p class="govuk-body">
        <a class="govuk-link" href={localePath(locale, '/start')}>
          Not sure which you need? Answer four questions.
        </a>
      </p>
    </div>
  </div>

  {shelf.length > 0 && (
    <section class="govuk-!-margin-top-6 govuk-!-margin-bottom-8">
      <h2 class="govuk-heading-m">Take what you need</h2>
      <p class="govuk-body">The four that do the most work.</p>
      <div class="govuk-grid-row">
        {shelf.map((entry) => (
          <div class="govuk-grid-column-one-half govuk-!-margin-bottom-5">
            <div class="app-card">
              <span class="app-card__meta">{entry.data.audience}</span>
              <h3 class="app-card__title">
                <a class="govuk-link" href={localePath(locale, `/artifacts/${slugOf(entry)}`)}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="govuk-body-s">{entry.data.summary}</p>
              <p class="govuk-body-s govuk-!-margin-bottom-0">
                <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.docx`} download>Word</a>
                <span aria-hidden="true"> · </span>
                <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.md`} download>Markdown</a>
                <span aria-hidden="true"> · </span>
                <a class="govuk-link" href={localePath('es', `/artifacts/${slugOf(entry)}`)} lang="es" hreflang="es">Español</a>
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      {[...grouped.filter((g) => g.entries.length > 0), { id: 'everyone', title: 'For any program', blurb: 'These apply whatever your size.', entries: everyone }]
        .filter((group) => group.entries.length > 0)
        .map((group) => (
          <section id={group.id} class="govuk-!-margin-bottom-8">
            <h2 class="govuk-heading-m">{group.title}</h2>
            <p class="govuk-body">{group.blurb}</p>

            <dl class="govuk-summary-list">
              {group.entries.map((entry) => (
                <div class="govuk-summary-list__row">
                  <dt class="govuk-summary-list__key">
                    <a class="govuk-link" href={localePath(locale, `/artifacts/${slugOf(entry)}`)}>
                      {entry.data.title}
                    </a>
                    {entry.data.phase > 1 && (
                      <span class="govuk-!-margin-left-1">
                        <strong class="govuk-tag govuk-tag--grey">Phase {entry.data.phase}</strong>
                      </span>
                    )}
                  </dt>
                  <dd class="govuk-summary-list__value">
                    <p class="govuk-body-s govuk-!-margin-bottom-1">{entry.data.summary}</p>
                    <p class="govuk-body-s govuk-!-margin-bottom-0">
                      {entry.data.tiers?.map((tier) => (
                        <span class="govuk-!-margin-right-1"><TierTag tier={tier} locale={locale} /></span>
                      ))}
                    </p>
                  </dd>
                  <dd class="govuk-summary-list__actions">
                    <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.docx`} download>
                      Word<span class="govuk-visually-hidden"> version of {entry.data.title}</span>
                    </a>
                    <span aria-hidden="true"> · </span>
                    <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.md`} download>
                      .md<span class="govuk-visually-hidden"> version of {entry.data.title}</span>
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))}

      <div class="govuk-inset-text">
        <h2 class="govuk-heading-s">The mechanic that compounds</h2>
        <p class="govuk-body">
          Programs are asked to send back the policy they actually adopted. Within two years that
          makes this the only body that knows what the field's AI policies really say — a research
          asset, a revision input, and a legitimacy claim at once.
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
          There is nowhere to send it yet. No body has been convened, and until one has, there is no
          one to receive it.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
