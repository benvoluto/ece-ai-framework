const c = copy[locale] ?? copy.en;
---

<BaseLayout title={t(locale, 'nav.about')} description={description} locale={locale}>
  <PageHeader
    caption={c.headerCaption}
    title={c.headerTitle}
    lede={lede}
    locale={locale}
    lastUpdated={lastUpdated}
  />

  <nav class="govuk-!-margin-bottom-6 app-no-print" aria-label={t(locale, 'label.onThisPage')}>
    <h2 class="govuk-heading-s">{t(locale, 'label.onThisPage')}</h2>
    <ul class="govuk-list govuk-body-s">
      {c.contents.map((item) => (
        <li>
          <a class="govuk-link govuk-link--no-visited-state" href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <h2 class="govuk-heading-m" id="what-this-is">{c.whatThisIsHeading}</h2>

  <div class="app-prose">
    <Content />
  </div>

  <h2 class="govuk-heading-m" id="the-table">{c.tableHeading}</h2>

  <p class="govuk-body">{c.tableIntro}</p>

  <p class="govuk-body">
    <strong>{c.tableIntro2Strong}</strong>{c.tableIntro2Rest}
  </p>

  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">{c.tableHeadWho}</th>
        <th scope="col" class="govuk-table__header">{c.tableHeadWhy}</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {c.constituencies.map((row) => (
        <tr class="govuk-table__row">
          <th scope="row" class="govuk-table__header">{row.who}</th>
          <td class="govuk-table__cell">{row.why}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="govuk-heading-m" id="credibility">{c.credibilityHeading}</h2>

  <p class="govuk-body">{c.credibilityIntro}</p>

  <ol class="govuk-list govuk-list--number">
    {c.moves.map((move) => (
      <li>
        <strong>{move.strong}</strong>{move.rest}
      </li>
    ))}
  </ol>

  <h2 class="govuk-heading-m" id="open-questions">{c.openQuestionsHeading}</h2>

  <p class="govuk-body">{c.openQuestionsIntro}</p>

  {c.openQuestions.map((item) => (
    <section id={`q${item.n}`} class="govuk-!-margin-bottom-6">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
        <span class="govuk-caption-m">{c.openQuestionCaption} {item.n}</span>
        {item.q}
      </h3>
      {item.paras.map((para) => <p class="govuk-body">{para}</p>)}
      {item.read && (
        <Annotation label={c.drafterRead}>
          <p class="govuk-body govuk-!-margin-bottom-0">{item.read}</p>
        </Annotation>
      )}
    </section>
  ))}

  <h2 class="govuk-heading-m" id="ai-use">{c.aiUseHeading}</h2>

  <p class="govuk-body">{c.aiUseIntro}</p>

  <ul class="govuk-list govuk-list--bullet">
    {c.aiUse.map((item) => (
      <li>
        {item.pre}{item.strong && <strong>{item.strong}</strong>}{item.post}
      </li>
    ))}
  </ul>

  <h2 class="govuk-heading-m" id="what-we-do-not-know">{c.gapsHeading}</h2>

  <p class="govuk-body">{c.gapsIntro}</p>

  <ul class="govuk-list govuk-list--bullet">
    {c.gaps.map((gap) => <li>{gap}</li>)}
  </ul>

  <h2 class="govuk-heading-m" id="verify">{c.verifyHeading}</h2>

  <p class="govuk-body">
    {c.verifyIntroPre}<strong>{c.verifyIntroStrong}</strong>{c.verifyIntroPost}
  </p>

  {c.verifyItems.map((item) => (
    <section id={item.id} class="govuk-!-margin-bottom-5">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">{item.heading}</h3>
      <p class="govuk-body-s govuk-!-margin-bottom-2">
        <strong class="govuk-tag govuk-tag--grey">{c.notYetChecked}</strong>
      </p>
      <p class="govuk-body">{item.body}</p>
    </section>
  ))}

  <h2 class="govuk-heading-m" id="build-sequence">{c.buildHeading}</h2>

  <p class="govuk-body">{c.buildIntro}</p>

  {c.phases.map((phase) => (
    <section id={`phase-${phase.n}`} class="govuk-!-margin-bottom-6">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
        <span class="govuk-caption-m">{c.phaseCaption} {phase.n} · {phase.requires}</span>
        {phase.name}
      </h3>
      <p class="govuk-body-s">
        <strong class="govuk-tag govuk-tag--grey">{phase.status}</strong>
      </p>
      <p class="govuk-body">{phase.blurb}</p>
      <ul class="govuk-list govuk-list--bullet">
        {phase.items.map((line) => <li>{line}</li>)}
      </ul>
    </section>
  ))}

  <div class="govuk-inset-text">
    <p class="govuk-body">{c.phasesInset}</p>
  </div>

  <Annotation label={c.sequencingLabel}>
    <p class="govuk-body govuk-!-margin-bottom-0">
      {c.seqIntro}
      <a class="govuk-link" href={localePath(locale, '/law')}>{c.seqLaw}</a> {c.seqMid1}
      <a class="govuk-link" href={localePath(locale, '/bright-lines')}>{c.seqBrightLines}</a> {c.seqMid2}
      <a class="govuk-link" href={localePath(locale, '/faq')}>{c.seqFaq}</a>{c.seqTail}
    </p>
  </Annotation>

  <h2 class="govuk-heading-m" id="sources">{c.sourcesHeading}</h2>

  <p class="govuk-body">{c.sourcesIntro}</p>

  <dl class="govuk-summary-list">
    {c.sourceGroups.map((group) => (
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{group.group}</dt>
        <dd class="govuk-summary-list__value">
          <ul class="govuk-list govuk-body-s govuk-!-margin-bottom-0">
            {group.items.map((source) => <li>{source}</li>)}
          </ul>
        </dd>
      </div>
    ))}
  </dl>

  <h2 class="govuk-heading-m" id="changelog">{c.changelogHeading}</h2>

  <p class="govuk-body">{c.changelogIntro}</p>

  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">{c.changelogHeadDate}</th>
        <th scope="col" class="govuk-table__header">{c.changelogHeadVersion}</th>
        <th scope="col" class="govuk-table__header">{c.changelogHeadWhat}</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {c.changelog.map((row) => (
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">
            <time datetime={row.date}>{row.display}</time>
          </td>
          <td class="govuk-table__cell">{row.version}</td>
          <td class="govuk-table__cell">{row.what}</td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
