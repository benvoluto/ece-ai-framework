---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntakeTool from '../IntakeTool.astro';
import TierTag from '../TierTag.astro';
import { SITE } from '../../lib/site.js';
import { siteVersion, localePath } from '../../lib/i18n.js';

const { locale = 'en' } = Astro.props;
const en = (entry) => entry.id.startsWith(`${locale}/`);
const slugOf = (entry) => entry.id.replace(new RegExp(`^${locale}/`), "");

/**
 * Six modules in the spec, minus STANDING, which is held back until the
 * convening question in Section 16 is resolved. Five here, in this order.
 */
const featured = (await getCollection('goodUses'))
  .filter((e) => en(e) && e.data.featuredOnHome)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const brightLines = (await getCollection('brightLines'))
  .filter(en)
  .sort((a, b) => a.data.number - b.data.number);

/** Three of the eight. Fixed rather than rotated, so a screenshot is stable. */
const homeLines = brightLines.filter((e) => [1, 2, 4].includes(e.data.number));

const shelf = (await getCollection('artifacts'))
  .filter((e) => en(e) && e.data.onShelf)
  .sort((a, b) => (a.data.shelfOrder ?? 99) - (b.data.shelfOrder ?? 99));

const faqEntries = (await getCollection('faq'))
  .filter((e) => en(e) && e.data.onHome)
  .sort((a, b) => (a.data.homeOrder ?? 99) - (b.data.homeOrder ?? 99));

const faqRendered = await Promise.all(
  faqEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

/** Page chrome in both languages. Content strings come from the collections. */
const copy = {
  en: {
    description:
      'A field resource for early childhood providers on the ethical and constructive use of AI. Answer four questions about the tool in front of you and get the guidance, the tier, and the right policy template.',
    routeHeading: 'Using AI in early childhood education? Access free tools and example policies.',
    routeLede:
      'Use our interactive tool. Answer a few questions and get an analysis of risk and the right documents for a program your size \u2014 a one-page policy for a family child care home, a full policy for a center, a governance charter for a grantee.',
    routeNote:
      '(Nothing you answer is sent anywhere. There is no sign-up, and every document on this site is free to download without one.)',
    helpsHeading: 'Safe and ethical ways to use AI, so you can spend more time with kids.',
    helpsLede:
      'Most of what AI can do in early childhood is unglamorous, low-risk, and can save time and money you can spend on children. Some examples, with risk tiers.',
    helpsAll: 'All twelve examples',
    linesHeading: 'Three uses of AI to avoid.',
    linesBasis: 'The basis for this',
    linesAll: 'All eight uses, each with the law or the evidence behind it',
    shelfHeading: 'Take what you need.',
    shelfLede:
      'No sign-up. Freely available and editable documents in Spanish and English.',
    shelfAll: 'All sixteen documents',
    versionOf: 'version of',
    whyHeading: 'Why does this site exist?',
    whyAll: 'The rest of the questions, including whether this is legal advice',
    standingLabel: 'Who wrote this, and when.',
    standingBody:
      'No standards body has been convened and no part of this has been reviewed by counsel. Until that changes, this site is a draft in public rather than a field standard.',
    standingLink: "What is settled, what is open, and how this site's own AI use worked",
    lastReviewed: 'last reviewed',
  },
  es: {
    description:
      'Un recurso para proveedores de educación temprana sobre el uso ético y constructivo de la IA. Responda cuatro preguntas sobre la herramienta que tiene enfrente y reciba la guía, el nivel de riesgo y la plantilla de política que le corresponde.',
    routeHeading: '¿Está considerando una herramienta de IA? Responda cuatro preguntas.',
    routeLede:
      'Usted completa una oración. Le devuelve el nivel de riesgo, lo que ese nivel le exige y el documento indicado para un programa de su tamaño: una política de una página para un hogar de cuidado infantil familiar, una política completa para un centro, una carta de gobernanza para un concesionario.',
    routeNote:
      'Nada de lo que usted responda se envía a ninguna parte. No hay que registrarse, y todos los documentos de este sitio se descargan gratis sin hacerlo.',
    helpsHeading: 'Tres lugares donde de verdad está el dinero.',
    helpsLede:
      'Casi todo lo que la IA puede hacer en la educación temprana no tiene nada de glamoroso, es de bajo riesgo y vale dinero real para un negocio que opera con márgenes de uno a tres por ciento. Cada hora que devuelve es una hora que un adulto pasa con los niños.',
    helpsAll: 'Los doce, cada uno con su nivel y su salvaguarda',
    linesHeading: 'Tres cosas que no se hacen, prometa lo que prometa la herramienta.',
    linesBasis: 'El fundamento de esto',
    linesAll: 'Los ocho, cada uno con la ley o la evidencia que lo respalda',
    shelfHeading: 'Tome lo que necesite.',
    shelfLede:
      'Sin formularios, sin pedir su correo. Editables, con espacios en blanco donde van sus propios datos, y una versión en inglés junto a cada uno.',
    shelfAll: 'Los dieciséis documentos',
    versionOf: 'versión de',
    whyHeading: '¿Por qué existe esto?',
    whyAll: 'Las demás preguntas, incluida si esto es asesoría legal',
    standingLabel: 'Quién escribió esto, y cuándo.',
    standingBody:
      'No se ha convocado ningún organismo de estándares y ningún abogado ha revisado nada de esto. Hasta que eso cambie, este sitio es un borrador en público, no un estándar del campo.',
    standingLink: 'Qué está decidido, qué sigue abierto y cómo se usó la IA para construir este sitio',
    lastReviewed: 'última revisión',
  },
};
const c = copy[locale] ?? copy.en;
const otherLocale = locale === 'en' ? 'es' : 'en';
---

<BaseLayout
  title={null}
  description={c.description}
  locale={locale}
  fullWidth
>
  {/* ------------------------------------------------------ 1 · ROUTE */}
  <section class="govuk-grid-row govuk-!-margin-bottom-8" id="route">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
        {c.routeHeading}
      </h1>
      <p class="govuk-body-l">
        {c.routeLede}
      </p>
      <p class="govuk-body">
        {c.routeNote}
      </p>

      <IntakeTool locale={locale} />
    </div>
  </section>

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

  {/* ---------------------------------------------- 2 · WHERE IT HELPS */}
  {featured.length > 0 && (
    <section class="govuk-!-margin-bottom-8" id="where-it-helps">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <h2 class="govuk-heading-l">{c.helpsHeading}</h2>
          <p class="govuk-body">
            {c.helpsLede}
          </p>
        </div>
      </div>

      <div class="govuk-grid-row">
        {featured.map((entry) => (
          <div class="govuk-grid-column-one-third govuk-!-margin-bottom-5">
            <div class="app-card">
              <span class="app-card__meta"><TierTag tier={entry.data.tier} locale={locale} link={false} /></span>
              <h3 class="app-card__title">
                <a class="govuk-link" href={`${localePath(locale, '/good-uses')}#${slugOf(entry)}`}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="govuk-body-s">{entry.data.homeSummary ?? entry.data.scenario}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <p class="govuk-body">
            <a class="govuk-link" href={localePath(locale, '/good-uses')}>
              {c.helpsAll}
            </a>
          </p>
        </div>
      </div>
    </section>
  )}

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

  {/* ----------------------------------------------- 3 · BRIGHT LINES */}
  {homeLines.length > 0 && (
    <section class="govuk-!-margin-bottom-8" id="bright-lines">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <h2 class="govuk-heading-l">{c.linesHeading}</h2>
          <ol class="govuk-list govuk-list--number govuk-!-margin-top-5">
            {homeLines.map((entry) => (
              <li class="govuk-!-margin-bottom-4">
                <span class="govuk-body-l">{entry.data.shortRule}</span>
                <br />
                <a class="govuk-link govuk-body-s" href={`${localePath(locale, '/bright-lines')}#line-${entry.data.number}`}>
                  {c.linesBasis}
                </a>
              </li>
            ))}
          </ol>
          <p class="govuk-body">
            <a class="govuk-link" href={localePath(locale, '/bright-lines')}>
              {c.linesAll}
            </a>
          </p>
        </div>
      </div>
    </section>
  )}

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

  {/* ------------------------------------------------- 4 · THE SHELF */}
  {shelf.length > 0 && (
    <section class="govuk-!-margin-bottom-8" id="shelf">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <h2 class="govuk-heading-l">{c.shelfHeading}</h2>
          <p class="govuk-body">
            {c.shelfLede}
          </p>
        </div>
      </div>

      <div class="govuk-grid-row">
        {shelf.map((entry) => (
          <div class="govuk-grid-column-one-half govuk-!-margin-bottom-5">
            <div class="app-card">
              <span class="app-card__meta">{entry.data.audience}</span>
              <h3 class="app-card__title">
                <a class="govuk-link" href={localePath(locale, `/artifacts/${slugOf(entry)}`)}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="govuk-body-s">{entry.data.summary}</p>
              <p class="govuk-body-s govuk-!-margin-bottom-0">
                <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.docx`} download>
                  Word<span class="govuk-visually-hidden"> {c.versionOf} {entry.data.title}</span>
                </a>
                <span aria-hidden="true"> · </span>
                <a class="govuk-link" href={`/artifacts/${locale}/${slugOf(entry)}.md`} download>
                  Markdown<span class="govuk-visually-hidden"> {c.versionOf} {entry.data.title}</span>
                </a>
                <span aria-hidden="true"> · </span>
                <a class="govuk-link" href={localePath(otherLocale, `/artifacts/${slugOf(entry)}`)} lang={otherLocale} hreflang={otherLocale}>
                  {otherLocale === 'es' ? 'Español' : 'English'}
                </a>
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <p class="govuk-body">
            <a class="govuk-link" href={localePath(locale, '/policies')}>{c.shelfAll}</a>
          </p>
        </div>
      </div>
    </section>
  )}

  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />

  {/* ---------------------------------------------- 5 · FAQ PREVIEW */}
  {faqRendered.length > 0 && (
    <section class="govuk-!-margin-bottom-8" id="why">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">
          <h2 class="govuk-heading-l">{c.whyHeading}</h2>

          <div class="govuk-accordion" data-module="govuk-accordion" id="home-faq">
            {faqRendered.map(({ entry, Content }, i) => (
              <div class="govuk-accordion__section">
                <div class="govuk-accordion__section-header">
                  <h3 class="govuk-accordion__section-heading">
                    <span class="govuk-accordion__section-button" id={`home-faq-heading-${i + 1}`}>
                      {entry.data.question}
                    </span>
                  </h3>
                </div>
                <div id={`home-faq-content-${i + 1}`} class="govuk-accordion__section-content">
                  <Content />
                </div>
              </div>
            ))}
          </div>

          <p class="govuk-body govuk-!-margin-top-6">
            <a class="govuk-link" href={localePath(locale, '/faq')}>
              {c.whyAll}
            </a>
          </p>
        </div>
      </div>
    </section>
  )}

  {/*
    6 · STANDING is deliberately absent. The spec puts member names, funders, a
    version and a last-reviewed date on the home page, on the argument that in
    this posture legitimacy is the product. No body has been convened, so there
    is nothing truthful to put there yet. The version and date stamp stay in the
    masthead and the footer; the rest waits.
  */}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <div class="govuk-inset-text">
        <p class="govuk-body">
          <strong>{c.standingLabel}</strong> {siteVersion(SITE, locale)}, {c.lastReviewed}{' '}
          <time datetime={SITE.lastReviewed}>{SITE.lastReviewed}</time>. {c.standingBody}
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
          <a class="govuk-link" href={localePath(locale, '/about')}>
            {c.standingLink}
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
