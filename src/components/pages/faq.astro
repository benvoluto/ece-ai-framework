---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import { t, localePath } from '../../lib/i18n.js';

const { locale = 'en' } = Astro.props;

const entries = (await getCollection('faq', (e) => e.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const items = await Promise.all(
  entries.map(async (entry, i) => {
    const { Content } = await render(entry);
    return { entry, Content, n: i + 1 };
  }),
);

const lastUpdated = entries
  .map((e) => e.data.lastUpdated)
  .sort()
  .at(-1);

const copy = {
  en: {
    description:
      'The objections people raise in the first meeting, answered: what states have and have not legislated, why K-12 guidance does not transfer, and what this site is not.',
    caption: 'Questions and objections',
    lede: 'Thirteen questions, each one a real objection. If you are being asked to justify spending twenty minutes on this, the answer is probably here.',
    stillDeciding: 'Still deciding where to start',
    stillBody1: 'If the answer you needed is not here, the three pages that do the most work are',
    startLink: 'Start here',
    stillBody2: ', which tiers a tool from four questions;',
    brightLinesLink: 'the bright lines',
    stillBody3: ', which is the short list of things not to do at all; and',
    lawLink: 'What the law says',
    stillBody4: ', which answers which law actually governs the data in your program.',
  },
  es: {
    description:
      'Las objeciones que la gente pone en la primera reunión, contestadas: qué han legislado los estados y qué no, por qué la orientación de K-12 no sirve aquí, y qué no es este sitio.',
    caption: 'Preguntas y objeciones',
    lede: 'Trece preguntas, cada una es una objeción real. Si le están pidiendo que justifique dedicarle veinte minutos a esto, la respuesta probablemente está aquí.',
    stillDeciding: 'Si todavía no sabe por dónde empezar',
    stillBody1: 'Si la respuesta que necesitaba no está aquí, las tres páginas que más trabajo hacen son',
    startLink: 'Empiece aquí',
    stillBody2: ', que le asigna un nivel a una herramienta con cuatro preguntas;',
    brightLinesLink: 'los límites infranqueables',
    stillBody3: ', que es la lista corta de lo que no se hace nunca; y',
    lawLink: 'Lo que dice la ley',
    stillBody4: ', que contesta cuál ley rige de verdad los datos de su programa.',
  },
};

const c = copy[locale] ?? copy.en;
---

<BaseLayout title={t(locale, 'nav.faq')} description={c.description} locale={locale}>
  <PageHeader
    caption={c.caption}
    title={t(locale, 'nav.faq')}
    lede={c.lede}
    locale={locale}
    lastUpdated={lastUpdated}
  />

  <nav class="govuk-!-margin-bottom-6 app-no-print" aria-label={t(locale, 'label.onThisPage')}>
    <h2 class="govuk-heading-s">{t(locale, 'label.onThisPage')}</h2>
    <ol class="govuk-list govuk-list--number govuk-body-s">
      {items.map(({ entry, n }) => (
        <li><a class="govuk-link govuk-link--no-visited-state" href={`#faq-${n}`}>{entry.data.question}</a></li>
      ))}
    </ol>
  </nav>

  <div class="govuk-accordion" data-module="govuk-accordion" id="accordion-faq">
    {items.map(({ entry, Content, n }) => (
      <div class="govuk-accordion__section" id={`faq-${n}`}>
        <div class="govuk-accordion__section-header">
          <h2 class="govuk-accordion__section-heading">
            <span class="govuk-accordion__section-button" id={`accordion-faq-heading-${n}`}>
              {entry.data.question}
            </span>
          </h2>
        </div>
        <div
          id={`accordion-faq-content-${n}`}
          class="govuk-accordion__section-content"
        >
          <Content />
        </div>
      </div>
    ))}
  </div>

  <h2 class="govuk-heading-m govuk-!-margin-top-8">{c.stillDeciding}</h2>
  <p class="govuk-body">
    {c.stillBody1}
    <a class="govuk-link" href={localePath(locale, '/start')}>{c.startLink}</a>{c.stillBody2}
    <a class="govuk-link" href={localePath(locale, '/bright-lines')}>{c.brightLinesLink}</a>{c.stillBody3}
    <a class="govuk-link" href={localePath(locale, '/law')}>{c.lawLink}</a>{c.stillBody4}
  </p>

  <script is:inline>
    // A link to #faq-7 should open section 7, not scroll to a closed heading.
    (function () {
      function openTarget() {
        var hash = window.location.hash;
        if (!/^#faq-\d+$/.test(hash)) return;
        var section = document.querySelector(hash);
        if (!section) return;
        var button = section.querySelector('.govuk-accordion__section-button');
        if (button && button.getAttribute('aria-expanded') === 'false') button.click();
        section.scrollIntoView();
      }
      window.addEventListener('load', openTarget);
      window.addEventListener('hashchange', openTarget);
    })();
  </script>
</BaseLayout>
